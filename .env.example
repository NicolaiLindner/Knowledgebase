# Zugang von tools/sql.py zur Arbeitsdatenbank (Modul Datenbank, MODUL-DATENBANK.md).
# Kopie als .env anlegen; .env steht in .gitignore und wird nie committet.
KB_SERVER=<server\instanz>
KB_DATABASE=<datenbank>
# Windows-Anmeldung (KB_TRUSTED=1) oder SQL-Login (KB_USER/KB_PASSWORD, dann KB_TRUSTED=0)
KB_TRUSTED=1
KB_USER=
KB_PASSWORD=
# Lesebenutzer fuer EXECUTE AS ... WITH NO REVERT (Einrichtung: tools/setup_kb_reader.sql).
# Nur ausdruecklich leer lassen (KB_READER=), wenn auf dem Server kein Benutzer angelegt werden darf -
# dann schuetzt allein der Werkzeug-Guard.
KB_READER=kb_reader
KB_DRIVER=ODBC Driver 18 for SQL Server
